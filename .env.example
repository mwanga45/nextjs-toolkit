# Runtime environment
NODE_ENV=development
LOG_LEVEL=info
SENTRY_DSN=

# External backend
API_BASE_URL=http://localhost:3000/api/mock
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_MOCKS=true

# JWT verification (configure one: JWKS or a shared secret)
JWT_JWKS_URL=
JWT_SECRET=development-only-secret-at-least-32-characters
JWT_ISSUER=next-toolkit-tests
JWT_AUDIENCE=next-toolkit-app

# Cookie configuration
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_MAX_AGE=604800
COOKIE_DOMAIN=
AUTH_REFRESH_LEEWAY_SECONDS=30
