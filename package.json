{
  "name": "next-toolkit",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "preinstall": "bun scripts/check-package-manager.ts",
    "dev": "next dev",
    "dev:mock": "NEXT_PUBLIC_ENABLE_MOCKS=true next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "api:types": "bun scripts/generate-api-types.ts",
    "env:check": "bun scripts/env-check.ts",
    "docker:up": "docker compose -f docker/docker-compose.yml up --build",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.7",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@sentry/nextjs": "11.15.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-query": "5.108.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jose": "6.2.18",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "pino": "10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.92.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-boundaries": "7.4.4",
    "husky": "9.1.7",
    "jsdom": "31.0.1",
    "lint-staged": "17.6.1",
    "msw": "3.0.7",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
